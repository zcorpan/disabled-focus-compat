#!/bin/sh
# Installed with: git config core.hooksPath hooks
PY=.venv/bin/python
[ -x "$PY" ] || PY=python3
# Crawl and HTTP Archive output only (no tester data): queries/, out-cc/, out-ha/.
exec "$PY" publish_check.py --staged "--crawl=queries/**/*.csv,queries/**/*.json,out-cc/**/*.*,out-ha/**/*.*"
